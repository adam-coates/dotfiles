            {
              "name": "Vienna",
              "zone": "Europe/Vienna"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            }
          ]
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "adam.stylinator"
    }
  ]
}
