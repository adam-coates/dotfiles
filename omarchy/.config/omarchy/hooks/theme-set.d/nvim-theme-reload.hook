#!/bin/bash
# Tell every running Neovim to re-read the theme Omarchy just staged.
# Neovim listens on $XDG_RUNTIME_DIR/nvim.<pid>.0 by default.

shopt -s nullglob

for socket in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/nvim.*; do
  [[ -S $socket ]] || continue
  nvim --server "$socket" --remote-expr "v:lua.require'omarchy.theme'.reload()" >/dev/null 2>&1 &
done

wait
